FROM python:3.10.16-alpine3.21


RUN apk add --no-cache --virtual .build-deps linux-headers musl-dev cmake make llvm15 llvm15-dev g++ gcc openblas-dev freetype-dev gfortran
RUN apk add libstdc++

# LLVM
ENV LLVM_CONFIG=/usr/lib/llvm15/bin/llvm-config

RUN mkdir -p /usr/src/exp
WORKDIR /usr/src/exp

COPY . .

# Install NumPy with the --no-cache-dir flag to reduce memory usage
RUN pip install --no-cache-dir numpy

# Install llvmlite and Numba with specific versions for better compatibility
# RUN pip install --no-cache-dir llvmlite==0.39.1 numba==0.56.4

RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt
RUN apk del .build-deps

# # # RUN python3 -c 'from watch_calibration import WatchCalibration; wc = WatchCalibration(); wc.generate_figures()'
